<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guestbook Submitted</title>
    <link rel="stylesheet" href="styles/confirm-styles.css">
</head>
<body>
    <nav>
        <a class="nav-button" href="/" role="button">Home</a>
        <a class="nav-button" href="/portfolio" role="button">Portfolio</a>
        <a class="nav-button" href="/contact-form" role="button">Contact Form</a>
        <a class="nav-button" href="/admin" role="button">Admin Page</a>
        <a class="nav-button" href="https://github.com/BushyMustache/guestbook" role="button">Github Repo</a>
        <a class="nav-button" href="https://www.linkedin.com/in/john-matheu-baltazar-6233263a5/" role="button">LinkedIn Profile</a>
    </nav>
    <h1>Thank you for your Submission!</h1>
    <h2>Submission Details</h2>
    <p>Name: <%= guest.fname %> <%= guest.lname %></p>
    <p>Job: <%= guest.job %></p>
    <p>Company:
        <% if (guest.company === "") { %>
        <%=   "none"   %>
        <% } else { %>
        <%=   guest.company   %>
        <% } %>
    </p>
    <p>LinkedIn URL:
        <% if (guest.url === "") { %>
        <%=   "none"   %>
        <% } else { %>
        <%=   guest.url   %>
        <% } %>
    </p>
    <p>Mailing List:
        <% if (guest.mail === "on") { %>
        <%=   "checked"   %>
        <% } else { %>
        <%=   "unchecked"   %>
        <% } %>
    </p>
    <p>Email:
        <% if (guest.email === "") { %>
        <%=   "none"   %>
        <% } else { %>
        <%=   guest.email   %>
        <% } %>
    </p>
    <p>Meet: 
        <% if (guest.meet !== "other") { %>
        <%=   guest.meet   %>
        <% } else { %>
        <%=   guest.other   %>
        <% } %>
    </p>
    <p>Message: 
        <% if (guest.message === "") { %>
        <%=   "none"   %>
        <% } else { %>
        <%=   guest.message   %>
        <% } %>
    </p>
    <p>Format: <%= guest.format %></p>
</body>
</html>