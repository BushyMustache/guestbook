<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Page</title>

    <script src="//code.jquery.com/jquery-3.7.1.js"></script>
    <script src="//cdn.datatables.net/2.3.7/js/dataTables.js"></script>
    <script src="//cdn.datatables.net/responsive/3.0.2/js/dataTables.responsive.min.js"></script>

    <link rel="stylesheet" href="styles/admin-styles.css">
    <link rel="stylesheet" href="//cdn.datatables.net/2.3.7/css/dataTables.dataTables.css">
    <link rel="stylesheet" href="//cdn.datatables.net/responsive/3.0.2/css/responsive.dataTables.min.css">
</head>
<body>
    <nav>
        <a class="nav-button" href="/" role="button">Home</a>
        <a class="nav-button" href="/portfolio" role="button">Portfolio</a>
        <a class="nav-button" href="/contact-form" role="button">Contact Form</a>
        <a class="nav-button" href="https://github.com/BushyMustache/guestbook" role="button">Github Repo</a>
        <a class="nav-button" href="https://www.linkedin.com/in/john-matheu-baltazar-6233263a5/" role="button">LinkedIn Profile</a>
    </nav>
    <%- include('header') %>
    <table id="guest-list" class="display">
        <thead>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Job</th>
                <th>Company</th>
                <th>LinkedIn</th>
                <th>Mailing List</th>
                <th>Email</th>
                <th>Meet</th>
                <th>Message</th>
                <th>Format</th>
            </tr>
        </thead>
        <tbody>
        <% guestbook.forEach(guest => { %>
            <tr>
                <td><%= guest.fname %></td>
                <td><%= guest.lname %></td>
                <td><%= guest.job %></td>
                <td>
                    <% if (guest.company === null) { %>
                    <%=   "none"   %>
                    <% } else { %>
                    <%=   guest.company   %>
                    <% } %>
                </td>
                <td>
                    <% if (guest.url === null) { %>
                    <%=   "none"   %>
                    <% } else { %>
                    <%=   guest.url   %>
                    <% } %>
                </td>
                <td>
                    <% if (guest.mail === "on") { %>
                    <%=   "checked"   %>
                    <% } else { %>
                    <%=   "unchecked"   %>
                    <% } %>
                </td>
                <td>
                    <% if (guest.email === null) { %>
                    <%=   "none"   %>
                    <% } else { %>
                    <%=   guest.email   %>
                    <% } %>
                </td>
                <td>
                    <% if (guest.meet !== "other") { %>
                    <%=   guest.meet   %>
                    <% } else { %>
                    <%=   guest.other   %>
                    <% } %>
                </td>
                <td>
                    <% if (guest.message === null) { %>
                    <%=   "none"   %>
                    <% } else { %>
                    <%=   guest.message   %>
                    <% } %>
                </td>
                <td>
                    <% if (guest.format === null) { %>
                    <%=   "none"   %>
                    <% } else { %>
                    <%=   guest.format   %>
                    <% } %>
                </td>
            </tr>
        <% }) %>
        </tbody>
    </table>

    <script>
        new DataTable('#guest-list', {
            responsive: true
        });
    </script>
</body>
</html>