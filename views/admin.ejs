<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Page</title>

    <script src="//code.jquery.com/jquery-3.7.1.js"></script>
    <script src="//cdn.datatables.net/2.3.7/js/dataTables.js"></script>
    <script src="//cdn.datatables.net/responsive/3.0.2/js/dataTables.responsive.min.js"></script>

    <link rel="stylesheet" href="//cdn.datatables.net/2.3.7/css/dataTables.dataTables.css">
    <link rel="stylesheet" href="//cdn.datatables.net/responsive/3.0.2/css/responsive.dataTables.min.css">
</head>
<body>
    <h1>The Guestbook</h1>
    <table id="guest-list" class="display">
        <thead>
            <tr>
                <th>Name</th>
                <th>Job</th>
                <th>Company</th>
                <th>LinkedIn</th>
                <th>Mailing List</th>
                <th>Email</th>
                <th>Meet</th>
                <th>Message</th>
                <th>Format</th>
                <th>Timestamp</th>
            </tr>
        </thead>
        <tbody>
        <% guestbook.forEach(guest => { %>
            <tr>
                <td><%= guest.fname %> <%= guest.lname %></td>
                <td><%= guest.job %></td>
                <td><%= guest.company %></td>
                <td><%= guest.url %></td>
                <td>
                    <% if (guest.mail === "on") { %>
                    <%=   "checked"   %>
                    <% } else { %>
                    <%=   "unchecked"   %>
                    <% } %>
                </td>
                <td><%= guest.email %></td>
                <td>
                    <% if (guest.meet !== "other") { %>
                    <%=   guest.meet   %>
                    <% } else { %>
                    <%=   guest.other   %>
                    <% } %>
                </td>
                <td><%= guest.message %></td>
                <td><%= guest.format %></td>
                <td><%= guest.timestamp.toLocaleString() %></td>
            </tr>
        <% }) %>
        </tbody>
    </table>

    <script>
        new DataTable('#guest-list', {
            responsive: true
        });
    </script>
</body>
</html>